# Copy to .env at the repo root. Both apps read this single file.
# Every variable is validated at startup (packages/types/src/env.ts); bad values fail fast.

# ---------- Shared ----------
NODE_ENV=development
# Public CDN/custom domain of the R2 bucket, e.g. https://img.yourstore.in (no trailing slash).
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Shared secret the API sends when asking Next.js to revalidate cached pages. >= 16 chars.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ---------- API (apps/api) ----------
API_PORT=4000
# MongoDB Atlas connection string (Atlas is a replica set, so transactions work).
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Database name (overrides any database in the URI path).
MONGODB_DB_NAME=catafy
# Origin of the web app. Used for CORS on direct API calls and Origin checks on admin mutations.
WEB_ORIGIN=http://localhost:3000
# Signs the owner session cookie. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# Seed only: the owner login created/updated by `pnpm seed`. Password >= 10 chars.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=admin12334567
# Cloudflare R2 (S3-compatible API). Create an API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=your-account-id
# Optional: S3 API endpoint. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=catafy-images
# Where the API reaches Next.js to trigger revalidation (optional until Phase 3).
WEB_INTERNAL_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------- Web (apps/web) ----------
# Server-side only: where Next.js proxies /api/v1/* to. Not exposed to the browser.
API_INTERNAL_URL=http://localhost:4000
# Canonical public URL of the storefront (used for Open Graph, sitemap, WhatsApp links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
